# Copy to .env and fill in. See docs/07-environment-variables.md for the full spec.

# --- Phase 1 (required) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fine_line_process?schema=public"
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# --- Phase 5+ (optional — leave unset to use the mock provider) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_SIGNING_SECRET=
# SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS=

# --- Phase 6+ ---
# REDIS_URL=
# CRON_SECRET=  # required for POST /api/cron/campaign-tick — external scheduler sends `Authorization: Bearer <secret>`

# --- File storage ---
# STORAGE_DRIVER=database   # "database" (durable, files in Postgres) or "local" (./.data/uploads).
#                           # Unset: database on Vercel (no persistent disk), local everywhere else.

# --- Phase 7+ ---
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY=

# --- Phase 8+ ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5   # optional, defaults to claude-sonnet-5
