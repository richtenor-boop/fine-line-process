  trusteeName    String?
  caseNumber     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@map("foreclosures")
}

enum TaxSaleStatus {
  UPCOMING
  SOLD
  REDEEMED
  SURPLUS_AVAILABLE
}

model TaxSale {
  id             String        @id @default(cuid())
  organizationId String
